# Rendered into /etc/dockerfile-agent/agent.env by the deploy workflow from repo variables and
# secrets. Never commit real values.

# Required: private repositories to keep a Dockerfile in (owner/name, comma separated)
REPOS=me/agent-a,me/agent-b

# Optional
#NOTIFY_URLS=https://discord.com/api/webhooks/<id>/<token>
#GIT_AUTHOR_NAME=Dockerfile agent
#GIT_AUTHOR_EMAIL=dockerfile-agent@localhost
#BASE_IMAGE=python:3.13-slim-trixie
#TIMEZONE=America/New_York
#POLL_SECONDS=60
#PUBLIC_GRACE_MINUTES=20
#WATCH_PUBLIC=true
#PUBLIC_SUFFIX=-public
#BRANCH=main
