# Generated by dockerfile-agent from: deploy/lxc/dockerfile-agent-install, deploy/lxc/bootstrap-agent.sh, requirements.txt, dockerfile_agent/config.py, dockerfile_agent/health.py.
# Don't edit by hand: it's regenerated whenever those files change. Change them instead.
#
# Build: docker build --pull --build-arg PATCHED_AT=$(date +%s) --build-arg REVISION=$(git rev-parse HEAD) -t dockerfile-agent .
# Run:   docker run -d --name dockerfile-agent --restart unless-stopped \
#     --env-file agent.env \
#     -v dockerfile-agent-data:/var/lib/dockerfile-agent \
#     dockerfile-agent
#
# agent.env holds the settings in .env.example (the deploy workflow renders it from repo variables and secrets).

FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ENV TZ=America/New_York

ARG DEBIAN_FRONTEND=noninteractive
ARG PATCHED_AT=unknown
RUN echo "Patching the base OS ($PATCHED_AT)" \
 && apt-get update \
 && apt-get -y full-upgrade \
 && apt-get install -y --no-install-recommends ca-certificates git openssh-client tzdata \
 && ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime && echo "$TZ" > /etc/timezone \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupadd --system dockerfile-agent \
 && useradd --system --gid dockerfile-agent --home-dir /var/lib/dockerfile-agent --shell /usr/sbin/nologin dockerfile-agent \
 && install -d -o dockerfile-agent -g dockerfile-agent /var/lib/dockerfile-agent

WORKDIR /opt/dockerfile-agent/app
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY dockerfile_agent/ ./dockerfile_agent/
ARG REVISION=unknown
RUN echo "$REVISION" > REVISION

ENV STATE_PATH=/var/lib/dockerfile-agent/state.json
USER dockerfile-agent
VOLUME ["/var/lib/dockerfile-agent"]
HEALTHCHECK --interval=60s --timeout=15s --start-period=2m --retries=3 \
  CMD ["python", "-m", "dockerfile_agent.health"]
CMD ["python", "-m", "dockerfile_agent"]
